# Local dev env files — must never ship in a deploy. .env here points
# FIRESTORE_EMULATOR_HOST at 127.0.0.1:8080 (dev-only); if uploaded, Next.js
# loads it and it silently shadows the real Vercel dashboard env vars at
# runtime, making Firestore calls try to reach a local emulator that doesn't
# exist in production.
.env
.env.local
.env.*.local

# Unrelated Flutter mobile app living in the same repo — not part of the
# Next.js web deployment, and its iOS CocoaPods symlinks break `vercel deploy`.
rememberquran/

# Large docs/reference files not needed for the build.
docs/*.pdf
docs/*.zip
*.pdf
*.docx
