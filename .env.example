# RememberQuran.com — environment template (M4)
# Copy to .env and fill in values. Never commit .env.

# App
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Quran content APIs (Quran.com/QDC — free, no key required).
# Not secrets; only here so the base URLs can be swapped without a code
# change (e.g. pointing at a staging mirror or an alternate source like
# Al-Quran Cloud). NEXT_PUBLIC_ because these are called from client
# components (AudioPlayerContext, ArabicWord, reciter pickers), not just
# server code — leave unset to use the defaults baked into the code.
# NEXT_PUBLIC_QURAN_CHAPTERS_API_URL=https://api.quran.com/api/v4
# NEXT_PUBLIC_QURAN_QDC_API_URL=https://api.qurancdn.com/api/qdc
# NEXT_PUBLIC_QURAN_WORD_AUDIO_URL=https://audio.qurancdn.com/

# Firebase (Firestore — user data only, never store Quran text)
# Service account: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes literal — the SDK unescapes them at runtime (see src/lib/firestore/admin.ts)
FIREBASE_PRIVATE_KEY=

# Local dev only — point at the Firestore emulator instead of production.
# Run `pnpm firebase:emulators` in another terminal, then set this.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Password-reset email (Resend)
RESEND_API_KEY=
EMAIL_FROM=RememberQuran <noreply@rememberquran.com>

# Optional SMTP fallback (if not using Resend)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

